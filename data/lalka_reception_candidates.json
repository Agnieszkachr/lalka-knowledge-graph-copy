    {
      "pbl_id": 471996,
      "title": "Bolesław Prus",
      "graph_type": "BookRecord",
      "record_kind": "książka o twórcy (przedmiotowa)",
      "section": "Hasła osobowe (literatura polska) - P",
      "parent_pbl_id": null,
      "year": 1998,
      "source": null,
      "annotation": "Wstęp.- I. \"Życie skromne\". II. \"Robota parobcza\". III. \"Powiastki\", czyli \"praca uboczna\". IV. \"Powieści z wielkich pytań naszej epoki\": 1. \"Placówka\" - \"powiastka, która \"rozrosła się ponad miarę\". - 2. \"Kto Lalkę przeżył - wiele przeżył\". - 3. \"Emancypantki\" - powieść, w której są \"bardzo ważne astronomiczne i filozoficzne rozmyślania\". - V. \"Faraon - powieść, która powinna \"rozejść się jak najszerzej i zostać jak najdłużej\". - VI. \"Dzieci, czyli rewolucja jako  \"tragedia pomyłek\".",
      "matched_fields": [
        "annotation"
      ],
      "decision": null,
      "user_notes": null
    },
    {
      "pbl_id": 472496,
      "title": "Jubileuszowe \"Żniwo u Prusa\". Materiały z międzynarodowej sesji prusowskiej w 1997 r.",
      "graph_type": "BookRecord",
      "record_kind": "książka o twórcy (przedmiotowa)",
      "section": "Hasła osobowe (literatura polska) - P",
      "parent_pbl_id": null,
      "year": 1998,
      "source": null,
      "annotation": "I. \"Sercu serc\": Poetycki hołd Bolesławowi Prusowi. - Nie/jubileuszowe głosy o Prusie. Zebrał Zbigniew Przybyła. - Zbigniew Przybyła: Sesja prusowska w Częstochowie na tle współczesnej prusologii. - II. Prus-artysta: Grażyna Borkowska: Prusa filozofia życia. - Tadeusz Bujnicki: Jak jest zrobiona \"Katarynka\"?. - Zbigniew Przybyła: Bohaterowie powieści Prusa w świetle jego \"Najogólniejszych ideałów życiowych\". - Hanna Voisine-Jechova: Wielowarstwowość narracyjna \"Lalki\" w kontekście powieści europejskiej drugiej połowy ubiegłego wieku. - Jolanta Sztachelska: Bolesław Prus - w mieście, czyli w centrum świata. - Anna Janicka: Stanisław Wokulski - pozytywistyczne powroty do bezsilności. - Aneta Mazur: Jeszcze o kamieniu w \"Lalce\" Prusa. - Marta Rabikowska: Sprawa kobieca w \"Lalce\" Prusa, czyli mizoginizm zneutralizowany. - Wioletta Długosz: Tuż przed... Preludia sytuacji intymnych w \"Lalce\" Prusa. - Bogdan Burdziej: \"Lalka\" Prusa o genezie pogromu warszawskiego (1881). Rekonesans problemu. - Tomasz Sobieraj: Dwie wizje \"rozkładu społecznego\": \"Lalka\" Prusa i \"Warszawa\" [Mariana] Gawalewicza. - Paulina Mądry: Funkcja listów w \"Lalce\". - Renata Stachura: Między Bogiem a fosforem. Spór o filozofię i lektura Tomasza a Kempis w \"Emancypantkach\" Prusa. - Henryk Michalski: Naturalizm Prusa (a dekonstrukcja). - Tadeusz Budrewicz: Farys spieszony. Wokół \"Ze wspomnień cyklisty\". - III. Prus-publicysta: Krzysztof Stępnik: Poglądy i język Prusa-statysty w \"Kronikach\" (1874-1887). - Jerzy Konieczny: Kraszewski, Sienkiewicz i Prus o pruskich represjach wobec Polaków. - Czesława Mykita-Glensk: Bolesław Prus a Śląsk. - Barbara Konarska-Pabiniak: Wielkomiejski dziennikarz Prus o Płocku i okolicy. - Elżbieta Hurnikowa: Warszawa w felietonach Prusa - Wiedeń w felietonistyce austriackiej. - Tokimasa Sekiguchi: Bolesław Prus o Japonii i Japończykach. - Zofia Mocarska-Tycowa: Bolesław Prus o malarstwie. - Mirosław Łapot: Bolesław Prus o teatrzykach ogródkowych. -",
      "matched_fields": [
        "annotation"
      ],
      "decision": null,
      "user_notes": null
    },
